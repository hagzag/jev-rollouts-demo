# Which decision service the gate calls: hosted | self-hosted
DECIDER=hosted

# Option 1 (hosted): API key from https://jev.opendef.com -> API keys (starts with ojv_live_)
# Your OpenAI-compatible provider key goes into your OpenJev account Settings, not here.
OPENJEV_API_KEY=

# Option 2 (self-hosted, advanced): OpenJev runs in the cluster and calls your provider directly
OPENAI_API_KEY=
OPENJEV_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://my-vllm.internal:8000/v1
